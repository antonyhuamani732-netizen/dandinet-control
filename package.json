{
  "name": "dandinet-control",
  "version": "0.1.0",
  "private": true,
  "description": "D@NDINET: sistema de cobranza ISP (PWA offline + Google Apps Script + Google Sheets)",
  "scripts": {
    "probar": "node pruebas-local/cuadre.js && node pruebas-local/fase1.js && node pruebas-local/fase2.js",
    "subir:pruebas": "clasp -P .clasp.pruebas.json push --force",
    "subir:prod": "clasp -P .clasp.produccion.json push --force",
    "abrir:pruebas": "clasp -P .clasp.pruebas.json open-script",
    "abrir:prod": "clasp -P .clasp.produccion.json open-script",
    "correr:pruebas": "clasp -u dandinet -P .clasp.pruebas.json run",
    "correr:prod": "clasp -u dandinet -P .clasp.produccion.json run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@google/clasp": "3.4.1"
  }
}
